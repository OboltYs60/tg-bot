async def show_games_page(update: Update, context: ContextTypes.DEFAULT_TYPE, user_id, page):
    games = user_games_cache.get(user_id, [])
    if not games:
        return
    
    total = len(games)
    pages = (total + 9) // 10
    start = (page - 1) * 10
    end = min(start + 10, total)
    
    text = f"🎮 **Страница {page}/{pages}**\n\n"
    total_hours = 0
    
    for i, game in enumerate(games[start:end], start+1):
        text += f"{i}. **{game['name']}** — {game['hours']} ч\n"
        total_hours += game['hours']
    
    text += f"\n📊 Всего: {round(total_hours, 1)} ч"
    
    keyboard = []
    buttons = []
    if page > 1:
        buttons.append(InlineKeyboardButton("◀️", callback_data=f"page_{user_id}_{page-1}"))
    if page < pages:
        buttons.append(InlineKeyboardButton("▶️", callback_data=f"page_{user_id}_{page+1}"))
    if buttons:
        keyboard.append(buttons)
    
    reply_markup = InlineKeyboardMarkup(keyboard) if keyboard else None
    
    if update.callback_query:
        await update.callback_query.message.edit_text(text, reply_markup=reply_markup, parse_mode='Markdown')
    else:
        await update.message.reply_text(text, reply_markup=reply_markup, parse_mode='Markdown')

