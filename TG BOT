def init_database():
    conn = sqlite3.connect('steam_bot.db')
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users
                 (user_id INTEGER PRIMARY KEY, steam_id TEXT)''')
    conn.commit()
    conn.close()

def save_steam_id(user_id, steam_id):
    conn = sqlite3.connect('steam_bot.db')
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO users (user_id, steam_id) VALUES (?, ?)", (user_id, steam_id))
    conn.commit()
    conn.close()

def get_steam_id(user_id):
    conn = sqlite3.connect('steam_bot.db')
    c = conn.cursor()
    c.execute("SELECT steam_id FROM users WHERE user_id = ?", (user_id,))
    result = c.fetchone()
    conn.close()
    return result[0] if result else None

def get_steam_id_from_custom(custom_url):
    try:
        if custom_url.isdigit() and len(custom_url) > 10:
            return custom_url, None
        
        url = "https://api.steampowered.com/ISteamUser/ResolveVanityURL/v1/"
        params = {'key': STEAM_API_KEY, 'vanityurl': custom_url}
        response = requests.get(url, params=params, timeout=10)
        data = response.json()
        
        if data['response']['success'] == 1:
            return data['response']['steamid'], None
        return None, "Пользователь не найден"
    except:
        return None, "Ошибка подключения"

def get_player_summary(steam_id):
    try:
        url = "https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/"
        params = {'key': STEAM_API_KEY, 'steamids': steam_id}
        response = requests.get(url, params=params, timeout=10)
        data = response.json()
        
        player = data['response']['players'][0]
        created = "Неизвестно"
        if 'timecreated' in player:
            created = datetime.fromtimestamp(player['timecreated']).strftime("%d.%m.%Y")
        
        states = {0: '⚫ Не в сети', 1: '🟢 В сети', 4: '🎮 В игре'}
        state = states.get(player['personastate'], '⚫ Не в сети')
        game = player.get('gameextrainfo', '')
        
        return {
            'name': player['personaname'],
            'created': created,
            'state': state,
            'game': game
        }
    except:
        return None

def get_player_games(steam_id):
    try:
        url = "https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/"
        params = {
            'key': STEAM_API_KEY,
            'steamid': steam_id,
            'include_appinfo': 1,
            'include_played_free_games': 1,
            'format': 'json'
        }
        response = requests.get(url, params=params, timeout=15)
        data = response.json()
        
        games = []
        if 'response' in data and 'games' in data['response']:
            for game in data['response']['games']:
                name = game.get('name', 'Без названия')
                hours = game.get('playtime_forever', 0) / 60
                if hours > 0:
                    games.append({'name': name, 'hours': round(hours, 1)})
        return games[:50]
    except:
        return []

def calculate_account_value(steam_id):
    try:
        url = "https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/"
        params = {
            'key': STEAM_API_KEY,
            'steamid': steam_id,
            'include_appinfo': 1,
            'format': 'json'
        }
        response = requests.get(url, params=params, timeout=15)
        data = response.json()
        
        if 'response' not in data or 'games' not in data['response']:
            return None, "Не удалось получить список игр"
            
        games = data['response']['games']
        total_value = 0
        expensive = []
        
        for game in games[:15]:
            app_id = game.get('appid')
            store_url = f"https://store.steampowered.com/api/appdetails?appids={app_id}&cc=ru"
            try:
                store_response = requests.get(store_url, timeout=5)
                store_data = store_response.json()
                if store_data.get(str(app_id), {}).get('success'):
                    game_data = store_data[str(app_id)]['data']
                    price_info = game_data.get('price_overview', {})
                    if price_info:
                        price = price_info.get('final', 0) / 100
                        if price > 0:
                            total_value += price
                            expensive.append({
                                'name': game_data.get('name', 'Неизвестно'),
                                'price': price
                            })
            except:
                continue
                
        expensive.sort(key=lambda x: x['price'], reverse=True)
        return {
            'total': round(total_value, 2),
            'total_games': len(games),
            'expensive': expensive[:5]
        }, None
    except:
        return None, "Ошибка расчета"

