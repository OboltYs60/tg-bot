async def handle_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    data = query.data
    if data.startswith("page_"):
        parts = data.split("_")
        user_id = int(parts[1])
        page = int(parts[2])
        await show_games_page(update, context, user_id, page)

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text
    
    if text == "👤 Мой профиль":
        await my_profile(update, context)
    elif text == "🎮 Мои игры":
        await my_games(update, context)
    elif text == "💰 Стоимость":
        await account_value(update, context)
    elif text == "🎁 Бесплатные игры":
        await free_games(update, context)
    elif text == "🔥 Популярное":
        await popular(update, context)
    elif text == "ℹ️ Помощь":
        await start(update, context)
    else:
        if context.user_data.get('waiting') == 'steam_id':
            await save_steam_id(update, context, text)
            context.user_data['waiting'] = None
        else:
            await show_profile(update, context, text)

def main():
    init_database()
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(handle_callback))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    print("✅ Бот запущен!")
    app.run_polling()

if __name__ == "__main__":
    main()
